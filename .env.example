# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas URI for production or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/medai_nexus

# Security & Authentication (Generate random 64-character secret strings for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI Integration (Google Gemini API — Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_DEV_MODE=false

# File Storage & Uploads
UPLOAD_DIR=uploads

# Application Identity
APP_NAME="MedAI Nexus"
APP_URL=http://localhost:5173
